    <script>
        function dispInv() {
            let invdisp = document.getElementById("fd_toti").value;
            document.getElementById("inv-disp").innerHTML = invdisp;
        }

        function dispROI() {
            let aged = document.getElementById("fd_roi").value;
            document.getElementById("age-disp").innerHTML = aged;
        }

        function dispTime() {
            let invdisp = document.getElementById("fd_idur").value;
            document.getElementById("dur-disp").innerHTML = invdisp;
        }

        function sbCalc() {
            // let tinv = 0;
            let fdtoti = document.getElementById("fd_toti").value;
            let fdroi = document.getElementById("fd_roi").value;
            let fdidur = document.getElementById("fd_idur").value;
            let toti = ((fdtoti * fdroi * fdidur) / 100);
            let mamnt = (parseInt(toti) + parseInt(fdtoti));
            // document.getElementById("inte").innerHTML = toti;
            // document.getElementById("mval").innerHTML = mamnt;
            let xtinv = (mamnt - toti);
            // document.getElementById("inte").innerHTML = "interest earned : ₹" + toti;
            // document.getElementById("mval").innerHTML = "Maturity Value : ₹" + mamnt;
            // console.log(toti, mamnt);

            // Table of Investments 
            let tblVal = "<tbody><tr><td>Total Investment</td><th class='text-end'>" + xtinv + "</td></tr><tr><td>Total Interest</td><th class='text-end'>" + toti + "</td</tr><tr><td>Maturity Value</td><th class='text-end'>" + mamnt + "</td></tr></tbody>";
            document.getElementById("myTbl").innerHTML = tblVal;
            // Table of Investments 

            // Pie Chart 
            var xValues = ["Total Investment", "Total Interest"];
            var yValues = [xtinv, toti];
            var barColors = ["#03a9f4", "#f50057"];

            new Chart("myChart", {
                type: "pie",
                data: {
                    labels: xValues,
                    datasets: [{
                        backgroundColor: barColors,
                        data: yValues
                    }]
                },
                options: {
                    legend: {
                        display: true
                    },
                    title: {
                        display: true
                    }
                }
            });
            // Pie Chart 
        }
    </script>
