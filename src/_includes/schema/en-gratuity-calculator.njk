  "mainEntity": [
    {
      "@type": "Question",
      "name": "How is gratuity calculated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For covered employers: 15 × last drawn basic + DA × years of service ÷ 26. Service above six months in the last year counts as a full year."
      }
    },
    {
      "@type": "Question",
      "name": "Who gets gratuity after one year?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fixed-term employees, under the Code on Social Security, 2020, which came into force on 21 November 2025. Permanent employees still need five years of continuous service, except on death or disability."
      }
    },
    {
      "@type": "Question",
      "name": "Is gratuity taxable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For government employees it is fully exempt. For private-sector employees it is exempt up to ₹20 lakh; any excess is taxed as salary."
      }
    },
    {
      "@type": "Question",
      "name": "What is the maximum gratuity amount?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The ceiling for private-sector employees is ₹20 lakh. Employers may pay more voluntarily, but the excess is taxable."
      }
    }
  ]
}
