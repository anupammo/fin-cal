  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are the GST rates in India now?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Since 22 September 2025 (GST 2.0) the main rates are 5% and 18%, with a special 40% rate for luxury and sin goods. Gold and silver are taxed at 3% and rough diamonds at 0.25%. Many essentials are exempt."
      }
    },
    {
      "@type": "Question",
      "name": "How do I remove GST from a total amount?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Divide the total by (1 + rate/100). For example, ₹1,180 including 18% GST: 1,180 ÷ 1.18 = ₹1,000 net price, so GST is ₹180."
      }
    },
    {
      "@type": "Question",
      "name": "Is there still a 12% or 28% GST slab?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Under GST 2.0 the 12% and 28% slabs were removed. Most 12% items moved to 5% and most 28% items moved to 18%, while some luxury and sin goods moved to 40%."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between CGST, SGST and IGST?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For a sale within one state the GST is split half-and-half into CGST and SGST. For a sale between states, the full amount is charged as IGST. The total tax is the same."
      }
    },
    {
      "@type": "Question",
      "name": "Is GST charged on health insurance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Individual health insurance and life insurance premiums are exempt from GST from 22 September 2025."
      }
    }
  ]
}
