      "@type": "Question",
      "name": "What is the EPF interest rate for 2025-26?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The EPFO declared 8.25% for FY 2025-26, the same as the previous year. The government ratified it in June 2026."
      }
    },
    {
      "@type": "Question",
      "name": "How much of my employer contribution goes to EPF?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Out of the employer's 12%, 8.33% of basic pay (capped at ₹15,000, so at most ₹1,250 a month) goes to the Employee Pension Scheme. The rest goes to your EPF account."
      }
    },
    {
      "@type": "Question",
      "name": "Is EPF withdrawal taxable?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, if you have completed 5 years of continuous service. Earlier withdrawals can attract TDS and tax, except in cases such as termination due to ill health or business closure."
      }
    },
    {
      "@type": "Question",
      "name": "Can I contribute more than 12% to EPF?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, through Voluntary Provident Fund (VPF). It earns the same interest rate, but your employer does not have to match it, and interest on total yearly contributions above ₹2.5 lakh is taxable."
      }
    }
  ]
