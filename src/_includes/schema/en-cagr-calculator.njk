  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do you calculate CAGR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Divide the final value by the initial value, raise the result to the power of 1 divided by the number of years, and subtract 1. Multiply by 100 for a percentage."
      }
    },
    {
      "@type": "Question",
      "name": "What is a good CAGR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends on the asset. Beating inflation (about 4–6% in India) is the minimum; 10–12% over the long term is considered good for equity investments."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between CAGR and XIRR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CAGR works for a single investment and a single end value. XIRR handles many investments and withdrawals on different dates, so it is the right measure for SIPs."
      }
    },
    {
      "@type": "Question",
      "name": "Can CAGR be negative?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. If the final value is lower than the initial value, CAGR is negative, showing the average yearly loss."
      }
    }
  ]
}
