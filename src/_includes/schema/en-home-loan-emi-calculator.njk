    {
      "@type": "Question",
      "name": "Do banks charge a penalty for prepaying a home loan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not on floating-rate home loans taken by individuals — RBI rules bar prepayment and foreclosure charges on them. Fixed-rate loans may have a charge."
      }
