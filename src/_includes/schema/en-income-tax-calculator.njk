<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is income up to ₹12 lakh tax free in FY 2026-27?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, under the new regime. The Section 87A rebate of up to ₹60,000 makes the tax zero when taxable income is up to ₹12 lakh. Salaried people also get a ₹75,000 standard deduction, so a salary of up to ₹12.75 lakh pays no tax. The rebate does not cover special-rate income such as capital gains."
      }
    },
    {
      "@type": "Question",
      "name": "How much tax do I pay on a ₹15 lakh salary?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Under the new regime about ₹97,500 including cess (taxable income ₹14.25 lakh after the ₹75,000 standard deduction). Under the old regime it depends on your deductions; with only 80C and 80D it is about ₹2.03 lakh."
      }
    },
    {
      "@type": "Question",
      "name": "Which is better, the old or the new tax regime?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For most people earning up to ₹25 lakh with modest deductions, the new regime is cheaper. The old regime can win if you claim large HRA, home-loan interest and 80C/80D deductions together. Use the calculator above to compare your exact numbers."
      }
    },
    {
      "@type": "Question",
      "name": "What is marginal relief under the new regime?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If your taxable income is slightly above ₹12 lakh, the tax you pay cannot exceed the amount by which your income exceeds ₹12 lakh. For example, on ₹12.10 lakh you pay ₹10,000 plus cess instead of ₹61,500."
      }
    },
    {
      "@type": "Question",
      "name": "Is the standard deduction available in both regimes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Salaried employees and pensioners get ₹75,000 in the new regime and ₹50,000 in the old regime."
      }
    },
    {
      "@type": "Question",
      "name": "Did Budget 2026 change the income tax slabs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The slabs, the ₹75,000 standard deduction and the ₹12 lakh rebate limit introduced in Budget 2025 continue for FY 2026-27. The new Income-tax Act, 2025 renumbers sections but keeps these amounts."
      }
    }
  ]
}
