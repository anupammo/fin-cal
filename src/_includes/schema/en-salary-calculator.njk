<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the in-hand salary for ₹12 lakh CTC?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "About ₹85,000 a month under the new regime if basic is 50% of CTC, PF is on full basic and gratuity is part of CTC. Income tax is zero because taxable income stays below ₹12 lakh after the ₹75,000 standard deduction."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between CTC, gross and net salary?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CTC is the total cost to the employer. Gross salary is CTC minus employer PF, gratuity and other employer-side costs. Net or in-hand salary is gross salary minus employee PF, professional tax, income tax and other deductions."
      }
    },
    {
      "@type": "Question",
      "name": "Is employer PF part of CTC?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In most private companies, yes. The employer contribution of 12% of basic is included in CTC, so it reduces your gross salary. Some companies pay it over and above CTC; switch off the option in the calculator in that case."
      }
    },
    {
      "@type": "Question",
      "name": "How much PF is deducted from salary?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "12% of basic pay plus dearness allowance. If your employer caps PF at the statutory wage ceiling of ₹15,000, the deduction is ₹1,800 a month."
      }
    }
  ]
}
