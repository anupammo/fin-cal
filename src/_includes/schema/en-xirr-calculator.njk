    {
      "@type": "Question",
      "name": "What is a good XIRR for a mutual fund SIP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Over 5 years or more, an XIRR of 10–14% is considered good for an equity fund in India. Over short periods XIRR swings a lot with the market, so judge it over the long term."
      }
    },
    {
      "@type": "Question",
      "name": "Why is my XIRR higher than my absolute return?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolute return ignores time. If much of your money was invested recently, the same gain was earned in a shorter time, so the yearly rate (XIRR) can be higher than it looks."
      }
    },
    {
      "@type": "Question",
      "name": "How is XIRR different from CAGR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CAGR assumes one investment and one final value. XIRR handles many investments and withdrawals on different dates, so it is the right measure for SIPs."
      }
    },
    {
      "@type": "Question",
      "name": "Is XIRR the same as Excel's XIRR function?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. This calculator uses the same method: it finds the rate at which the present value of all dated cash flows, using a 365-day year, equals zero."
      }
    }
  ]
