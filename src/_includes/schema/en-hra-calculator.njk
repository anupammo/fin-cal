      "@type": "Question",
      "name": "Can I claim HRA in the new tax regime?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. HRA exemption is available only if you opt for the old tax regime."
      }
    },
    {
      "@type": "Question",
      "name": "Is the landlord's PAN mandatory for HRA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, if the rent you pay is more than ₹1 lakh in a year, you must give your landlord's PAN to your employer."
      }
    },
    {
      "@type": "Question",
      "name": "Can I claim HRA if I pay rent to my parents?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, if you actually pay rent, ideally by bank transfer with a rent agreement, and your parents declare it as income. You cannot claim HRA for a house you own."
      }
    }
