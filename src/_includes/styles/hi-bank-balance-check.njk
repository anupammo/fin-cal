{% raw %}
<style>
        .ng-card-white {
            background: #fff;
        }

        .ng-title-blue {
            color: #001169;
        }

        .ng-bank-details-hidden {
            display: none;
        }

        .ng-bank-logo {
            height: 36px;
            width: auto;
            max-width: 180px;
            object-fit: contain;
            filter: drop-shadow(0 2px 8px #eaf1ff);
        }

        .ng-call-btn {
            font-size: 1.1rem;
        }

        nav.navbar {
            background-color: #00000077;
        }

        a.navbar-brand img {
            margin-top: -5px;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.1) !important;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        /* header {
            background: linear-gradient(245deg, #3b3b3b 0%, #FDFF96 100%), linear-gradient(245deg, #0038FF 0%, #000000 100%), radial-gradient(100% 225% at 100% 0%, #4200FF 0%, #001169 100%), linear-gradient(245deg, #000000 0%, #FFB800 100%), radial-gradient(115% 107% at 40% 100%, #EAF5FF 0%, #EAF5FF 40%, #A9C6DE calc(40% + 1px), #A9C6DE 70%, #247E6C calc(70% + 2px), #247E6C 85%, #E4C666 calc(85% + 2px), #E4C666 100%), linear-gradient(65deg, #083836 0%, #083836 40%, #66D37E calc(40% + 1px), #66D37E 60%, #C6E872 calc(60% + 1px), #C6E872 100%);
            background-blend-mode: overlay, screen, overlay, hard-light, overlay, normal;
            background-attachment: fixed;
            background-size: cover;
        } */

        header {
            background: #FF9933;
            background: linear-gradient(165deg, rgba(255, 153, 51, 1) 0%, rgba(255, 153, 51, 1) 25%, rgba(255, 255, 255, 1) 25%, rgba(255, 255, 255, 1) 65%, rgba(19, 136, 8, 1) 65%, rgba(19, 136, 8, 1) 100%);
            background-blend-mode: overlay, screen, overlay, hard-light, overlay, normal;
            background-attachment: fixed;
            background-size: cover;
        }

        header::before {
            content: "";
            position: absolute;
            top: 25%;
            right: 5%;
            width: 150px;
            height: 150px;
            background-image: url('https://upload.wikimedia.org/wikipedia/commons/thumb/1/17/Ashoka_Chakra.svg/330px-Ashoka_Chakra.svg.png');
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            transform: translate(-50%, -50%);
            opacity: 0.4;
            /* Subtle watermark effect */
            pointer-events: none;
            /* Allows clicks to pass through */
            z-index: 0;
        }

        .wave1 {
            background: #ffffff;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0) 75%, rgba(255, 255, 255, 1) 75%, rgba(255, 255, 255, 1) 100%);
            /* text-decoration: none; */
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        a {
            color: rgba(0, 17, 105, 1);
        }

        /* ul li {
            list-style: none;
        } */

        a small,
        a svg {
            display: block;
            margin: 0 auto;
            text-align: center;
        }

        a small {
            font-size: .6rem;
        }

        a.nav-link {
            transition: none;
        }

        .bg-duo {
            background: rgb(255, 255, 255);
            background: linear-gradient(180deg, rgba(255, 255, 255, 1) 50%, rgba(0, 0, 0, 0) 50%);
        }
    </style>
{% endraw %}
