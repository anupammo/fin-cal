{% raw %}
<style>
        body {
            margin: 0;
            height: 100vh;
            display: block;
            background: rgb(130, 202, 255);
            background: linear-gradient(0deg, rgba(130, 202, 255, 1) 0%, rgba(255, 255, 255, 1) 30%, rgba(255, 255, 255, 1) 70%, rgba(130, 202, 255, 1) 100%);
        }

        h1 {
            margin: 0;
            padding-top: 60px;
            text-align: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-weight: 100;
        }

        p {
            padding-bottom: 60px;
            text-align: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        p span a {
            text-decoration: none;
            padding: 0px 5px;
        }

        header {
            display: block;
            width: 100%;
            height: 150px;
        }

        svg {
            max-width: 400px;
            height: auto;
            margin: 0 auto;
            display: block;
            filter: drop-shadow(2px 4px 6px black);
        }
    </style>
{% endraw %}
